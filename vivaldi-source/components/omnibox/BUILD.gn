source_set("omnibox") {
  sources = [
    "omnibox_input.h",
    "omnibox_service.cc",
    "omnibox_service.h",
    "omnibox_service_observer.h",
  ]
  deps = [
    "//third_party/flatbuffers",
    "//third_party/tflite_support:tflite_support_proto",
  ]

  if (!is_ios) {
    deps += [
      "//components/omnibox/browser",
      "//content/public/browser",
    ]
  }
  configs += [
    "//third_party/tflite:tflite_config",
    "//third_party/tflite_support:tflite_support_config",
  ]
}

source_set("vivaldi_url_utils") {
  sources = [
    "vivaldi_url_utils.cc",
    "vivaldi_url_utils.h",
  ]
  deps = [
    "//base",
    "//url",
  ]

  # url_cleaning depends on keyed_service/content which requires use_blink
  # (false on iOS), so exclude it from iOS builds.
  if (!is_ios) {
    deps += [ "//vivaldi/thirdparty/brave/common:url_cleaning" ]
  }
  if (is_android) {
    deps += [ "//chrome/browser/ui/android/toolbar:jni_headers" ]
  }
}

static_library("browser") {
  sources = [
    "omnibox_service_factory.cc",
    "omnibox_service_factory.h",
  ]
  deps = [
    ":omnibox",
    "//base:i18n",
    "//third_party/tflite",
    "//third_party/tflite_support",
    "//third_party/tflite_support:tflite_support_proto",
  ]
  if (is_ios || is_android) {
    deps += [ ":vivaldi_url_utils" ]
  }
}
