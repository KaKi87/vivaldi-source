update_target("//third_party/search_engines_data:prepopulated_engines_action") {
  # change the actual output folder from gen/vivaldi/components/search_engines
  # to gen/components/search_engines
  args += [
    "-b",
    rebase_path("$root_gen_dir/third_party/search_engines_data/",
                root_build_dir),
  ]

  # updates the path of the resulting files to be compiled to match the new
  # output folder
  outputs = []
  outputs = [
    "$root_gen_dir/third_party/search_engines_data/search_engines.cc",
    "$root_gen_dir/third_party/search_engines_data/search_engines.h",
  ]
}

update_template_instance(
    "//third_party/search_engines_data:regional_settings") {
  source = "//vivaldi/components/search_engines/regional_settings.json"
  deps += [ "//vivaldi/components:prepopulated_copy" ]
}

update_target("//third_party/search_engines_data:regional_settings_action") {
  # change the actual output folder from gen/vivaldi/components/search_engines
  # to gen/components/search_engines
  args += [
    "-b",
    rebase_path("$root_gen_dir/third_party/search_engines_data/",
                root_build_dir),
  ]

  # updates the path of the resulting files to be compiled to match the new
  # output folder
  outputs = []
  outputs = [
    "$root_gen_dir/third_party/search_engines_data/regional_settings.cc",
    "$root_gen_dir/third_party/search_engines_data/regional_settings.h",
  ]

  visibility += [ "//components/search_engines:search_engine_utils" ]
}

