  update_target("//chrome:chrome_initial") {
    deps -= [
      "//chrome/installer/util:did_run_support",
    ]
    deps += [
      "//vivaldi/installer/mini_installer/util:did_run_support",
    ]
  }

  update_target("//chrome/updater:base") {
    deps -= [
      "//chrome/installer/util:metainstaller_utils",
    ]
    deps += [
      "//vivaldi/installer/mini_installer/util:metainstaller_utils",
    ]
  }

  if (vivaldi_build_tests) {
    update_target("//chrome/test:browser_tests_runner") {
      deps -= [
        "//chrome/installer/util:strings",
      ]
      deps += [
        "//vivaldi/installer/mini_installer/util:strings",
      ]
    }
  }
}

