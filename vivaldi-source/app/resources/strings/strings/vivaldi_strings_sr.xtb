<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sr">
<translation id="2392002507524894126">Ауторско право <ph name="YEAR" /> Vivaldi Technologies AS. Сва права задржана.</translation>
<translation id="2611953850925269349">Ипак затворити Vivaldi?</translation>
<translation id="2885378588091291677">Управљач задацима</translation>
<translation id="3642991949832251880">Ипак изаћи из Vivaldi прегледача?</translation>
<translation id="4308441064174569580">&amp;Отвори у Vivaldi прегледачу</translation>
<translation id="5167047459440711824">Упозорење: Vivaldi не може да спречи проширења да снимају вашу историју прегледања. Да бисте онемогућили ово проширење у приватном режиму, поништите избор ове опције.</translation>
<translation id="5288672417093782294">Иди на подешавања обавештења за Vivaldi</translation>
<translation id="5743878272102782872">Управљач задацима - Vivaldi</translation>
<translation id="6524604576097824284">Када је укључено, Vivaldi ослобађа меморију од неактивних картица. То даје активним картицама и другим апликацијама више ресурса рачунара и одржава Vivaldi брзим. Ваше неактивне картице аутоматски поново постају активне када се вратите на њих. <ph name="BEGIN_LINK" />Сазнајте више<ph name="END_LINK" /></translation>
<translation id="7100573672995171864">Прилагодите и контролишите Vivaldi</translation>
<translation id="7642161109152167169">Када је укључено, Vivaldi штеди енергију батерије ограничавањем активности у позадини и визуелних ефеката, као што су глатко померање и брзина смењивања слика видео записа. <ph name="BEGIN_LINK" />Сазнајте више<ph name="END_LINK" /></translation>
<translation id="8031581238030785388">Vivaldi апликације</translation>
<translation id="8532558197615073846">{NUM_EXTENSIONS, plural,
        =1 {Ово проширење је искључено јер га Chromium више не подржава. За сада га можете поново укључити, али би ускоро могло бити уклоњено. Размислите о тражењу алтернатива у Chrome веб продавници.}
        other {Ова проширења су искључена јер их Chromium више не подржава. За сада их можете поново укључити, али би ускоро могла бити уклоњена. Размислите о тражењу алтернатива у Chrome веб продавници.}}</translation>
</translationbundle>
