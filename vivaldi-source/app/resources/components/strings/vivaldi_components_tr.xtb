<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="tr">
<translation id="3830627370375585318">Güvenlik duvarınızdan ya da anti-virüs ayarlarından,
        Vivaldi'nin ağa erişmesine izin verin.</translation>
<translation id="4932161901409251843">Git
          Vivaldi menüsü &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ögesine gidin ve yapılandırmanızın "vekil yok" veya "doğrudan" olarak ayarlandığından emin olun.</translation>
<translation id="4949828774841497663">Uygulamalar &gt; Sistem Tercihleri &gt; Ağ bölümüne gidin,
          aktif ağı seçin, Ayrıntılar... düğmesine tıklayın ve seçilmiş olabilecek
          tüm vekil sunucuların işaretini kaldırın.</translation>
<translation id="5248344925342018662">Güvenli bir Vivaldi sayfasını görüntülüyorsunuz</translation>
<translation id="6690242244468452299">Bu sayfa, çökme raporlamasını etkinleştirirseniz son çökmelerinizle ilgili bilgileri gösterir.</translation>
<translation id="7023871570427738255">Vivaldi menüsü &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" /> öğesine gidin
          ve "<ph name="NO_PREFETCH_DESCRIPTION" />" seçeneğinin işaretini kaldırın.
          Bu işlem sorunu çözmezse performansın iyileşmesi için bu seçeneği tekrar işaretlemenizi öneririz.</translation>
<translation id="7496505986576158197">Vivaldi, <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> açık kaynak projesi ve diğer <ph name="BEGIN_LINK_OSS" />açık kaynak yazılımları<ph name="END_LINK_OSS" /> tarafından mümkün kılınmıştır.</translation>
<translation id="89559930087159128">Şu işlemleri yapın
          Vivaldi menüsüne gidin &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Ağ ve internet &gt; Vekil sunucu bölümüne gidin
          ve "Ayarları otomatik olarak algıla" seçeneğinin işaretini kaldırın.</translation>
</translationbundle>
