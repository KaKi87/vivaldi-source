<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1682285232070778125">Vivaldi-ն դարձնել հիմնական բրաուզեր</translation>
<translation id="1775102330209840064">Կիսվել խափանումների հաշվետվություններով՝ օգնելու համար մեզ բարելավել ծրագրի որակը</translation>
<translation id="1974060860693918893">Ընդլայնված</translation>
<translation id="2053560788696003312">Vivaldi-ի համար անհրաժեշտ է Windows 10 կամ ավելի բարձր։</translation>
<translation id="2134216661302048561">Տեղադրիչը չի ավարտել Vivaldi բրաուզերի տեղադրումը։ Վստա՞հ եք, որ ուզում եք հենց հիմա դուրս գալ։</translation>
<translation id="237789874664518125">Copyright <ph name="YEAR" /> Vivaldi Technologies AS։ Բոլոր իրավունքները պաշտպանված են։ &lt;a&gt;Գաղտնիության դրույթներ&lt;/a&gt;</translation>
<translation id="3355081107855563356">Սեղմելով «Ընդունել և տեղադրել» կոճակը՝ Դուք համաձայնում եք Vivaldi-ի &lt;a&gt;Օգտագործման պայմաններին&lt;/a&gt;</translation>
<translation id="335985608243443814">Զննել…</translation>
<translation id="3485073444286678268">Տեղադրման պանակն անվավեր է։ Խնդրում ենք ընտրել մեկ ուրիշը։</translation>
<translation id="3601875200579023345">Տվյալ օգտատիրոջ համար</translation>
<translation id="3784826321032465839">Vivaldi-ի տեղադրում</translation>
<translation id="4066679519692422625">Տեղադրումը ձախողվեց անհայտ սխալի պատճառով։ Խնդրում ենք նորից ներբեռնել Vivaldi-ն։</translation>
<translation id="421958613172216971">Ընտրել պանակ</translation>
<translation id="4380252528729894811">Տեղադրման պանակ</translation>
<translation id="460304900852424163">Անջատել ավտոմատ թարմացումները (խորհուրդ չի տրվում)</translation>
<translation id="4619978527973181021">Ընդունել և տեղադրել</translation>
<translation id="479976146866774527">Vivaldi-ի տեղադրում</translation>
<translation id="5051728323101947360">Հնարավոր դարձնել անկախ տեղադրված Vivaldi-ն նշանակել ստանդարտ հավելված</translation>
<translation id="5247376421371319618">Ընդունել և թարմացնել</translation>
<translation id="5302048478445481009">Լեզու</translation>
<translation id="6665592435383088482">Անկախ</translation>
<translation id="694714344624446243">Vivaldi-ի տեղադրիչ</translation>
<translation id="7298195798382681320">Խորհուրդ տրվող</translation>
<translation id="7467493612551448880">Vivaldi-ի տարբերակը, որը տեղադրում եք, օպտիմալացված չէ Windows-ի այն տարբերակի համար, որն օգտագործում եք:

Անցեք vivaldi.com/download, որպեսզի ներբեռնեք Windows-ի Arm տարբերակի համար։</translation>
<translation id="7658239707568436148">Չեղարկել</translation>
<translation id="8773751185824654197">Նշում. բացված Vivaldi բրաուզերը թարմացնելու պարագայում այն կփակվի և կվերաբացվի</translation>
<translation id="9163437061188815291">Սեղմելով «Ընդունել և թարմացնել» կոճակը՝ Դուք համաձայնում եք Vivaldi-ի &lt;a&gt;Օգտագործման պայմաններին&lt;/a&gt;</translation>
<translation id="9175596866737867642">Պատրաստվեք անգերազանցելի հարմարեցման հնարավորություններին և ներկառուցված բրաուզերի ֆունկցիաներին, որոնք ապահովում են ավելի բարձր արդյունավետություն, արտադրողականություն և գաղտնիություն 🎉</translation>
<translation id="933060950687965486">Տեղադրման տեսակ</translation>
<translation id="963837307749850257">Բոլոր օգտատերերի համար</translation>
</translationbundle>
