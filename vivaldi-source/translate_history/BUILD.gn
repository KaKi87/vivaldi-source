static_library("translate_history") {
  sources = [
    "th_codec.cc",
    "th_codec.h",
    "th_constants.cc",
    "th_constants.h",
    "th_model.cc",
    "th_model.h",
    "th_model_loaded_observer.cc",
    "th_model_loaded_observer.h",
    "th_model_loader.cc",
    "th_model_loader.h",
    "th_model_observer.h",
    "th_node.cc",
    "th_node.h",
    "th_storage.cc",
