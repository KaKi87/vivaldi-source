      "th_service_factory.cc",
      "th_service_factory.h",
    ]
  }

  deps = [
    "//base",
    "//base:i18n",
    "//components/keyed_service/core",
    "//skia",
    "//third_party/icu",
    "//ui/base",
    "//url",
    "//vivaldi/app:vivaldi_native_resources",
