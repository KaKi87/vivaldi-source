import("//chrome/version.gni")

source_set("base") {
  sources = [ "containers/enum_array.h" ]

  deps = [ "//base" ]
}

source_set("obsolete_md5") {
  sources = [
    "vivaldi_md5.cc",
    "vivaldi_md5.h",
  ]

  deps = [
    "//base",
    "//crypto",
  ]
}

action("edge_version") {
  edge_version_file = "edge_versions.json"
  edge_version_header = "$target_gen_dir/base/edge_version.h"
  edge_version_header_template = "//vivaldi/base/edge_version.h.in"

  edge_version_json = read_file(edge_version_file, "json")

  if (defined(edge_version_json["v" + chrome_version_major])) {
    edge_version = edge_version_json["v" + chrome_version_major]
    edge_version = "EDGE_VERSION='\"$edge_version\"'"
  } else {
    not_needed([ "edge_version_json" ])
    edge_version = "EDGE_VERSION='CHROME_PRODUCT_VERSION'"
  }

  inputs = [
    edge_version_file,
    edge_version_header_template,
  ]

  outputs = [ edge_version_header ]

  script = "//build/util/version.py"

  args = [
    "-e",
    edge_version,
    "-i",
    rebase_path(edge_version_header_template, root_build_dir),
    "-o",
    rebase_path(edge_version_header, root_build_dir),
  ]
}

action("chrome_spoof_version") {
  spoof_version_file = "//vivaldi/SPOOF_CHROME"
  spoof_version_header = "$target_gen_dir/base/chrome_spoof_version.h"
  spoof_version_header_template = "//vivaldi/base/chrome_spoof_version.h.in"

  chromium_version_file = "//chrome/VERSION"

  inputs = [
    spoof_version_file,
    spoof_version_header_template,
    chromium_version_file,
  ]

  outputs = [ spoof_version_header ]

  script = "//build/util/version.py"

  args = [
    "-f",
    rebase_path(spoof_version_file, root_build_dir),
    "-f",
    rebase_path(chromium_version_file, root_build_dir),
    "-i",
    rebase_path(spoof_version_header_template, root_build_dir),
    "-o",
    rebase_path(spoof_version_header, root_build_dir),
  ]
}
