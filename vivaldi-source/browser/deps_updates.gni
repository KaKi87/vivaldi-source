import("//build/config/ui.gni")
import("//extensions/buildflags/buildflags.gni")
import("//ui/webui/webui_features.gni")
import("//vivaldi/testing/testing.gni")

if (!is_android && !is_mac) {
  update_target("//chrome:chrome_initial") {
    if (is_linux && current_cpu == "x86") {
      ldflags += [
        "-z",
        "notext",
      ]
    }
  }
}

if (is_win) {
  update_target("//chrome:chrome_dll") {
    deps += [ "//vivaldi/browser" ]
  }

  update_target("//chrome:chrome_initial") {
    data_deps -= [
      "//chrome/chrome_proxy",
      "//chrome/elevation_service",
    ]
    data_deps += [ "//vivaldi/tools/vivaldi_proxy" ]
  }
}

update_target("//chrome:dependencies") {
  public_deps += [ "//vivaldi/browser" ]
}

if (is_android) {
  update_target("//chrome:chrome_android_core") {
    deps += [ "//vivaldi/browser" ]
  }
}

update_target("//chrome/browser:browser") {
  public_deps += [
    "//vivaldi/browser",
    "//vivaldi/browser:features",
    "//vivaldi/browser:internal_handlers",
    "//vivaldi/browser:removed_partners_tracker",
    "//vivaldi/browser/ad_blocker",
    "//vivaldi/browser/kagi_token",
    "//vivaldi/components:tabs",
    "//vivaldi/components/policy:vivaldi_policy_handlers",
  ]
  configs += [ "//vivaldi/gn/config:release_kind" ]

  if (!is_android) {
    deps -= [
      "//chrome/browser/default_browser",
      "//chrome/browser/ui/startup/default_browser_prompt",
      "//chrome/browser/ui/startup/default_browser_prompt:impl",
      "//chrome/browser/ui/webui/default_browser:default_browser_modal",
      "//chrome/browser/ui/webui/default_browser:modal_mojo_bindings",
    ]
  }
  if (is_win || is_mac) {
    deps -= [
      "//chrome/browser/ui/startup/default_browser_prompt/pin_infobar:impl",
    ]
  }
  if (is_win) {
    deps -= [ "//chrome/browser/ui/webui/default_browser:visual_guided_setter" ]
  }
}

update_target("//chrome/browser/ui/autofill:impl") {
  deps += [
    "//components/browser_apis/browser_controls:mojom_data_model_shared_cpp_sources",
    "//components/browser_apis/ui_controllers/toolbar:extensions_bar_data_model_mojom",
    "//components/browser_apis/ui_controllers/toolbar:icon_handle_mojom",
    "//components/browser_apis/ui_controllers/toolbar:mojom_data_model",
  ]
}

update_target("//chrome/browser/ui/search_engines:search_engines") {
  deps += [
    "//components/browser_apis/browser_controls:mojom_data_model_shared_cpp_sources",
    "//components/browser_apis/ui_controllers/toolbar:extensions_bar_data_model_mojom",
    "//components/browser_apis/ui_controllers/toolbar:icon_handle_mojom",
    "//components/browser_apis/ui_controllers/toolbar:mojom_data_model",
  ]
}

if (!is_android) {
  update_target("//chrome/browser/notifications:impl") {
    deps -= [ "//chrome/browser/default_browser" ]
  }
  update_target("//chrome/browser:core") {
    deps -= [
      "//chrome/browser/default_browser",
      "//chrome/browser/ui/startup/default_browser_prompt",
    ]
  }

  update_target("//chrome/browser/ui/toolbar:impl") {
    deps -= [ "//chrome/browser/ui/startup/default_browser_prompt" ]
  }

  update_target("//chrome/browser/ui/webui:configs") {
    deps -=
        [ "//chrome/browser/ui/webui/default_browser:default_browser_modal" ]
    if (is_win) {
      deps -=
          [ "//chrome/browser/ui/webui/default_browser:visual_guided_setter" ]
    }
  }

  update_target("//chrome/browser/ui/webui/infobar_internals:impl") {
    deps -= [ "//chrome/browser/ui/startup/default_browser_prompt" ]
  }

  update_target("//chrome/browser/resources:resources") {
    public_deps -= [ "default_browser/default_browser_modal:resources" ]
    if (is_win) {
      public_deps -= [ "default_browser/visual_guided_setter:resources" ]
    }
  }

  update_target("//chrome/browser/ui/webui/settings:impl") {
    deps -= [
      "//chrome/browser/default_browser",
      "//chrome/browser/ui/startup/default_browser_prompt",
    ]
  }
}

update_target("//chrome/browser/ui:ui") {
  public_deps += [
    "//components/sessions",
    "//vivaldi/browser",
    "//vivaldi/prefs:prefs_strings",
  ]
  if (is_mac) {
    public_deps += [ "//vivaldi/browser:init_sparkle" ]
  }
  deps += [ "//chrome/services/sharing/public/proto" ]

  if (!is_android) {
    deps -= [
      "//chrome/browser/ui/webui/default_browser:default_browser_modal",
      "//chrome/browser/ui/webui/default_browser:modal_mojo_bindings",
    ]
  }
  if (is_win) {
    deps -= [ "//chrome/browser/ui/webui/default_browser:visual_guided_setter" ]
  }
}

update_target("//content/browser:browser") {
  if (ozone_platform_x11) {
    public_deps += [ "//ui/events/keycodes:x11" ]
  }
  public_deps += [ "//vivaldi/browser:clipboard" ]
}

update_target("//components/input:input") {
  public_deps += [ "//vivaldi/browser:clipboard" ]
}

if (!is_android) {
  #  update_target("//chrome/browser/password_manager/actor_login/internal:delegate") {
  #    deps += [
  #      "//components/paint_preview/buildflags",
  #      "//pdf:buildflags",
  #    ]
  #  }

  update_target("//chrome/browser/safe_browsing:safe_browsing") {
    deps += [ "//components/themes:ntp_background_proto" ]
  }
}

if (enable_webui_ntp) {
  update_target(
      "//chrome/browser/ui/webui/new_tab_page/action_chips:action_chips") {
    deps += [
      "//components/page_image_service/mojom:mojo_bindings",
      "//ui/webui/resources/cr_components/composebox:mojo_bindings",
    ]
  }
}

update_target("//chrome/browser/ui/webui/version:version") {
  configs += [ "//vivaldi/gn/config:release_kind" ]
}

update_target("//chrome/browser/page_load_metrics:impl") {
  deps += [ "//components/contextual_search/footprints/public/proto:footprints_oneplatform_proto" ]
}

if (vivaldi_build_tests) {
  update_target("//chrome/test/data/webui:browser_tests") {
    deps -=
        [ "//chrome/browser/ui/webui/default_browser:default_browser_modal" ]
  }

  update_target("//chrome/test:browser_tests") {
    deps -= [ "//chrome/browser/ui/webui/default_browser:browser_tests" ]
  }
}
