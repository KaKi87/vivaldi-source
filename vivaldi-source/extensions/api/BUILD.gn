  ]

  # url_cleaning depends on keyed_service/content which requires use_blink
  # (false on iOS), so exclude it from iOS builds.
  if (!is_ios) {
    deps += [ "//vivaldi/thirdparty/brave/common:url_cleaning" ]
  }

  # Needed for media support detection in vivaldi.utilities
  if (is_win) {
    libs = [ "mfplat.lib" ]

    # MediaFoundation is not available on Windows N, so must be delay loaded.
    all_dependent_configs = [ ":delay_load_mf" ]

    # Needed for update version info
    deps += [ "//chrome/updater:version_header" ]
  }

