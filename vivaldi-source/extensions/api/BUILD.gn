  if (!vivaldi_disable_sparkle) {
    sources += [
      "autoupdate/autoupdate_api.cc",
      "autoupdate/autoupdate_api.h",
      "autoupdate/autoupdate_status.h",
    ]
    if (is_mac) {
      sources += [ "autoupdate/auto_update_api_mac.mm" ]
    }
    if (is_win) {
      sources += [ "autoupdate/auto_update_api_win.cc" ]
    }
    if (is_linux) {
      sources += [
        "autoupdate/auto_update_api_linux.cc",
        "autoupdate/linux_update_checker.cc",
        "autoupdate/linux_update_checker.h",
      ]
    }
  }

  if (is_linux) {
    sources += [
      "vivaldi_utilities/launch_bar_gnome_support.cc",
      "vivaldi_utilities/launch_bar_gnome_support.h",
      "vivaldi_utilities/vivaldi_utilities_api_linux.cc",
      "window_private/window_private_api_linux.cc",
    ]

    if (use_gio) {
      configs += [ "//build/linux:gio_config" ]
    }
  }
  if (is_mac) {
    sources += [
      "vivaldi_utilities/drag_download_items_mac.mm",
      "vivaldi_utilities/vivaldi_utilities_api_mac.mm",
      "window_private/window_private_api_mac.mm",
    ]

    # For auto_update_api.cc:
    if (use_lld) {
      defines = [ "CHROMIUM_LINKER_NAME=\"lld\"" ]
    } else {
      defines = [ "CHROMIUM_LINKER_NAME=\"ld\"" ]
    }
  }
  if (is_win) {
    sources += [
      "vivaldi_utilities/vivaldi_utilities_api_win.cc",
      "window_private/window_private_api_win.cc",
    ]
  }
  if (use_aura) {
    sources += [ "vivaldi_utilities/drag_download_items_aura.cc" ]
  }

  # PWA API depends on web_applications which is desktop-only
  if (!is_android) {
    deps += [
      "//chrome/browser/web_applications",
      "//components/webapps/browser",
    ]
    sources += [
      "pwa/pwa_api.cc",
      "pwa/pwa_api.h",
    ]
  }
  configs += [
    ":api_keys",
    "//vivaldi/gn/config:release_kind",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "mail_private/mail_private_api_test.cc" ]
  deps = [
    ":apis",
    "//base",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
