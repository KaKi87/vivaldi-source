[
  {
    "namespace": "sitePermissions",
    "description": "API for handling per-site permissions in Chrome Extensions.",
    "compiler_options": {
      "implemented_in": "extensions/api/site_permissions/site_permissions_api.h"
    },
    "types": [
      {
        "id": "PermissionSetting",
        "type": "string",
        "enum": ["allow", "block", "ask", "sessionOnly", "default"]
      },
      {
        "id": "Permission",
        "type": "object",
        "properties": {
          "origin": { "type": "string" },
          "secondaryOrigin": { "type": "string", "optional": true },
          "permission": { "type": "string" },
          "setting": { "$ref": "PermissionSetting" }
        },
        "required": ["origin", "permission", "setting"]
      },
      {
        "id": "PermissionOptions",
        "type": "object",
        "properties": {
          "permission": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "$ref": "PermissionSetting" }
          },
          "default": { "$ref": "PermissionSetting" },
          "requiresSecondaryOrigin": { "type": "boolean" }
        },
        "required": ["permission", "options", "default", "requiresSecondaryOrigin"]
      },
      {
        "id": "SitePermissionInfo",
        "type": "object",
        "description": "Information about a site with overridden permissions.",
        "properties": {
          "origin": { "type": "string" },
          "count": { "type": "integer" }
        },
        "required": ["origin", "count"]
      },
      {
        "id": "PermissionChangeEvent",
        "type": "object",
        "description": "Fired when site permission changes.",
        "properties": {
          "origin" : { "type": "string" },
          "permission" : { "type": "string" }
        }
      }
    ],
    "functions": [
      {
        "name": "getAvailablePermissions",
        "type": "function",
        "description": "Returns all available site permissions and their possible settings, including the default.",
        "parameters": [],
        "returns_async": {
          "name": "callback",
          "parameters": [
            {
              "name": "permissions",
              "type": "array",
              "items": { "$ref": "PermissionOptions" }
            }
          ]
        }
      },
      {
        "name": "getOverriddenSites",
        "type": "function",
        "description": "Returns a list of all sites with overridden permissions, including the count of overridden permissions for each site.",
        "parameters": [],
        "returns_async": {
          "name": "callback",
          "parameters": [
            {
              "name": "sites",
              "type": "array",
              "items": { "$ref": "SitePermissionInfo" }
            }
          ]
        }
      },
      {
        "name": "getOverridesForSite",
        "type": "function",
        "description": "Returns a list of permission overrides for a specific site. For permissions with secondary origins, all secondary origins are included in the result array.",
        "parameters": [
          { "name": "origin", "type": "string" }
        ],
        "returns_async": {
          "name": "callback",
          "parameters": [
            { "name": "result",
              "type": "array",
              "items": { "$ref": "Permission" }
            }
          ]
        }
      },
      {
        "name": "setSitePermission",
        "type": "function",
        "description": "Sets the permission override for a given site. For permissions that support secondary origins, secondaryOrigin must be provided.",
        "parameters": [
          { "name": "origin", "type": "string" },
          { "name": "secondaryOrigin", "type": "string" },
          { "name": "permission", "type": "string" },
          { "name": "setting", "$ref": "PermissionSetting" }
        ],
        "returns_async": {
          "name": "callback",
          "parameters": [
          ]
        }
      },
      {
        "name": "resetSitePermissions",
        "type": "function",
        "description" : "Resets all site permissions to default. This includes all permissions where the primary pattern matches the origin, including all secondary origins (wildcard match).",
        "parameters": [
          { "name": "origin", "type": "string" }
        ],
        "returns_async": {
          "name": "callback",
          "parameters": [
          ]
        }
      }
    ],
    "events": [
      {
        "name": "onPermissionChanged",
        "type": "function",
        "description": "Fired when a site permission changes.",
        "parameters": [
          { "name": "event", "$ref": "PermissionChangeEvent" }
        ]
      }
    ]
  }
]
