import("//build/config/apple/swift_source_set.gni")

source_set("custom_views") {
  sources = [
    "custom_view_constants.h",
    "custom_view_constants.mm",
    "vivaldi_rich_link_text_models.h",
    "vivaldi_rich_link_text_models.mm",
    "vivaldi_rich_link_text_view.h",
    "vivaldi_rich_link_text_view.mm",
    "vivaldi_text_field_view.h",
    "vivaldi_text_field_view.mm",
    "vivaldi_search_bar_view.h",
    "vivaldi_search_bar_view.mm",
    "vivaldi_text_view.h",
    "vivaldi_text_view.mm"
  ]

  deps = [
    "//base",
  ]

  frameworks = [
    "Foundation.framework",
    "UIKit.framework",
  ]
}

swift_source_set("custom_views_swift") {
  sources = [
    "vivaldi_empty_message_view.swift",
    "vivaldi_radio_button.swift",
  ]

  deps = [
    "//ios/chrome/common/ui/colors:swift",
  ]

  frameworks = [
    "UIKit.framework",
    "SwiftUI.framework",
  ]
}

swift_source_set("custom_views_rich_text_swift") {
  bridge_header = "vivaldi_custom_views_swift_bridge.h"
  sources = [ "vivaldi_rich_link_text_view.swift" ]

  deps = [ ":custom_views" ]

  frameworks = [
    "UIKit.framework",
    "SwiftUI.framework",
  ]
}
