import("//build/config/apple/swift_source_set.gni")

source_set("top_toolbar") {
  sources = [ "vivaldi_ntp_top_toolbar_view_consumer.h" ]

  frameworks = [ "UIKit.framework" ]

  deps = [
    ":top_toolbar_swift",
    "//base",
    "//ui/base",
  ]
}

swift_source_set("top_toolbar_swift") {
  bridge_header = "vivaldi_ntp_top_toolbar_view_swift_bridge.h"
  sources = [
    "vivaldi_ntp_top_toolbar_item.swift",
    "vivaldi_ntp_top_toolbar_state.swift",
    "vivaldi_ntp_top_toolbar_view.swift",
    "vivaldi_ntp_top_toolbar_view_cell.swift",
  ]

  deps = [
    "//base",
    "//ui/base",
    "//vivaldi/app:vivaldi_ios_native_strings",
  ]

  frameworks = [
    "UIKit.framework",
    "SwiftUI.framework",
  ]
}
