# Minimal extensions sources for Android (enable_extensions_core=false).
# Mirrors brave-core's //brave/extensions:common pattern.
import("//extensions/buildflags/buildflags.gni")

if (!enable_extensions_core) {
  source_set("ext_url_patterns") {
    sources = [
      "//extensions/common/url_pattern.cc",
      "//extensions/common/url_pattern.h",
      "//extensions/common/url_pattern_set.cc",
      "//extensions/common/url_pattern_set.h",
      "//extensions/common/error_utils.cc",
      "//extensions/common/error_utils.h",
    ]
    inputs = [
      "//extensions/common/constants.h",
    ]
    deps = [
      "//base",
      "//content/public/common",
      "//net",
      "//url",
      "//vivaldi/app",
    ]
  }
}

# debounce
source_set("debounce") {
  # Keep source code verbatim, vanilla, unchanged.
  include_dirs = [ "//vivaldi/thirdparty" ]
  sources = [
    "debounce/core/browser/debounce_rule.cc",
    "debounce/core/browser/debounce_rule.h",
    "debounce/core/browser/debounce_service.cc",
    "debounce/core/browser/debounce_service.h",
    "debounce/core/browser/debounce_service_factory.cc",
    "debounce/core/browser/debounce_service_factory.h",
  ]
  deps = [
    "//third_party/re2",
    "//vivaldi/thirdparty/brave/common:cached_rule_service",
    "//base",
    "//chrome/browser/profiles",
    "//components/keyed_service/content",
    "//components/prefs",
    "//url",
  ]
  if (enable_extensions_core) {
    deps += [ "//extensions/common" ]
  } else {
    deps += [ ":ext_url_patterns" ]
  }
}

# query_filter
source_set("query_filter") {
  # Keep source code verbatim, vanilla, unchanged.
  include_dirs = [ "//vivaldi/thirdparty" ]
  sources = [
    "query_filter/browser/query_filter_data.cc",
    "query_filter/browser/query_filter_data.h",
    "query_filter/browser/utils.cc",
    "query_filter/browser/utils.h",
    "query_filter/common/features.cc",
    "query_filter/common/features.h",
    "query_filter/common/internal/schema_utils.cc",
    "query_filter/common/internal/schema_utils.h",
    "query_filter/common/schema.cc",
    "query_filter/common/schema.h",
    "query_filter/query_filter_service.cc",
    "query_filter/query_filter_service.h",
    "query_filter/query_filter_service_factory.cc",
    "query_filter/query_filter_service_factory.h",
  ]
  deps = [
    "//vivaldi/thirdparty/brave/common:cached_rule_service",
    "//base",
    "//chrome/browser/profiles",
    "//components/keyed_service/content",
    "//components/url_pattern_index",
    "//net",
    "//third_party/re2",
    "//url",
  ]
}

# url_sanitizer
source_set("url_sanitizer") {
  include_dirs = [ "//vivaldi/thirdparty" ]
  sources = [
    "url_sanitizer/url_sanitizer_service.cc",
    "url_sanitizer/url_sanitizer_service.h",
    "url_sanitizer/url_sanitizer_service_factory.cc",
    "url_sanitizer/url_sanitizer_service_factory.h",
  ]
  deps = [
    "//vivaldi/thirdparty/brave/common:cached_rule_service",
    "//base",
    "//chrome/browser/profiles",
    "//components/keyed_service/content",
    "//url",
  ]
  if (enable_extensions_core) {
    deps += [ "//extensions/common" ]
  } else {
    deps += [ ":ext_url_patterns" ]
  }
}


